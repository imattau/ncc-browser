{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nostr Navigator",
  "version": "0.30.1",
  "identifier": "io.github.imattau.nccbrowser",
  "build": {
    "frontendDist": "../mobile",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nostr Navigator",
        "width": 420,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26,
      "versionCode": 30001,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
