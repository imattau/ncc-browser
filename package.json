{
  "name": "ncc-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop browser that resolves services through Nostr Community Convention NCC-05 instead of DNS",
  "main": "./out/main/index.js",
  "author": "lostcause",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "nostr-tools": "^2.26.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.18.0"
  }
}
