{
  "name": "ncc-browser",
  "version": "0.44.1",
  "private": true,
  "description": "A cross-platform Nostr browser for desktop and Android, with NCC-05 browsing and Bitcoin, Monero, and Lightning wallets",
  "main": "./out/main/index.js",
  "desktopName": "nostr-navigator.desktop",
  "author": "imattau",
  "license": "MIT",
  "scripts": {
    "dev": "npm run nccsearch:build && npm run site-publisher:build && electron-vite dev",
    "build": "npm run nccsearch:build && npm run site-publisher:build && npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "mobile:dev": "npm run nccsearch:build && vite --config vite.mobile.config.ts",
    "mobile:build": "npm run nccsearch:build && vite build --config vite.mobile.config.ts",
    "nccsearch:build": "node scripts/build-nccsearch.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "publisher:dev": "npm --prefix publisher run dev",
    "publisher:build": "npm --prefix publisher run build",
    "e2e": "npm run build && npm run publisher:build && node scripts/e2e-smoke.mjs",
    "tor:fetch": "node scripts/fetch-tor.mjs",
    "tor:fetch:all": "node scripts/fetch-tor.mjs --all",
    "dist": "npm run tor:fetch && npm run build && electron-builder --publish never",
    "dist:linux": "npm run tor:fetch -- linux-x64 && npm run build && electron-builder --linux deb rpm flatpak --x64 --publish never",
    "dist:mac": "npm run tor:fetch -- mac-x64 mac-arm64 && npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "npm run tor:fetch -- win-x64 && npm run build && electron-builder --win nsis --x64 --publish never",
    "ext:init": "node packages/extension-sdk/bin/ncc-ext.mjs init",
    "ext:validate": "node packages/extension-sdk/bin/ncc-ext.mjs validate",
    "ext:port": "node packages/extension-sdk/bin/ncc-ext.mjs port",
    "ext:pack": "node packages/extension-sdk/bin/ncc-ext.mjs pack",
    "tauri": "tauri",
    "e2e:hosting": "npm run build && node scripts/e2e-hosting-smoke.mjs",
    "site-publisher:build": "node scripts/build-site-publisher.mjs",
    "site-publisher:test": "npm --prefix site-publisher test",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@nostrify/nostrify": "^0.55.1",
    "@scure/btc-signer": "^2.4.1",
    "@tauri-apps/api": "^2.12.4",
    "adblock-rs": "^0.13.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.545.0",
    "monero-ts": "^0.11.22",
    "nostr-tools": "^2.26.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socks-proxy-agent": "^10.1.0",
    "tldts": "^7.5.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.18.0"
  }
}
